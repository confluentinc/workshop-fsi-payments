# --- Self-service flags (leave false so labs stay hands-on) ---
enable_flink_mts          = false
enable_tableflow_topics   = false
enable_shadowtraffic      = true
enable_risk_api           = true
enable_risk_udf           = true
risk_api_key              = "riverpay-workshop-risk"
